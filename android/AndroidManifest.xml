<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xnuroid.loader"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- "All files access", asked for only by apps whose documents live on shared storage (see host_shared_storage) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:theme="@style/Theme.Xnuroid">
        <activity
            android:name="com.xnuroid.HostActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|touchscreen|uiMode|density|fontScale|locale|layoutDirection|mcc|mnc"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="xnuroid" />
            <meta-data android:name="android.app.func_name" android:value="xnuroid_on_create" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
